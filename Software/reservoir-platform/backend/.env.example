# Dify 配置
# 复制为 server/.env 后填入真实密钥（.env 已 gitignore，切勿提交）
# 后端通过 spring.config.import 自动加载该文件
DIFY_API_BASE=https://dify.qianxiao.xin/v1
DIFY_API_KEY=app-xxxxxxxx
DIFY_USER=reservoir-user
DIFY_TIMEOUT=120

# 本地 FunASR 语音识别服务
ASR_BASE_URL=http://127.0.0.1:8001
ASR_ENABLED=true

# 语音合成方式：browser（浏览器原生，默认）/ aliyun（预留）
TTS_PROVIDER=browser

# 跨域白名单（逗号分隔，支持通配）。
# 注意：即使前端与后端同域部署也必须写生产域名——浏览器发 POST 会带 Origin 头，
# 不在白名单里会被 Spring 以 "Invalid CORS request" 返回 403（登录就卡在这）。
# 键名必须是点分形式（application.yml 里用 ${app.cors.allowed-origin-patterns} 读取）。
app.cors.allowed-origin-patterns=https://zhka.demo.ai.qianxiao.xin,http://localhost:*,http://127.0.0.1:*

# 消息推送（token 的正常维护入口是管理页「系统设置 → 推送与告警」，存 MySQL platform_setting）
# 这里只配接口基础地址/开关；PUSH_TOKEN 是数据库没配置时的兜底，一般留空
PUSH_BASE_URL=https://push.showdoc.com.cn/server/api/push
PUSH_ENABLED=true
PUSH_TOKEN=

# 实时阈值告警（MQTT 读数越界时推送）
ALERT_ENABLED=true
# 同一指标两次推送的最小间隔（分钟），0 表示不限制
ALERT_COOLDOWN_MINUTES=10
# 登录异常告警按账号维度的冷却时间（分钟）
LOGIN_ALERT_COOLDOWN_MINUTES=5

# 展示用站点名，出现在告警推送与导出文件名里
STATION_NAME=水库监测站
# 无时区时间参数、CSV、推送时间的解释时区
PLATFORM_ZONE_ID=Asia/Shanghai

# ─────────── 平台后端（登录 / 台账 / 水情采集） ───────────

# MySQL：登录、台账、阈值、消息、推送配置。库不存在或服务未启动时，问答功能仍可用
DB_URL=jdbc:mysql://localhost:3306/dam?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# MongoDB：只存水情读数（water_readings）；登录/台账/阈值/消息/告警/推送配置都在 MySQL。
# 数据库没启动时，采集会丢当批数据，管理页查询返回 503 提示，但不影响应用启动与其它功能。
# 注意：URI 路径里必须带库名，否则 Spring Data 启动时报 "Database name must not be empty"。
MONGO_URI=mongodb://user:password@127.0.0.1:27017/zhka-db?authSource=zhka-db&connectTimeoutMS=3000&serverSelectionTimeoutMS=3000
# authSource 是存放该账号的库（通常与库名相同；用 admin 库创建的账号则写 authSource=admin）

# MQTT（RTU 水情上报）；无 broker 时置 MQTT_ENABLED=false 可免去告警日志
# 注意：填远程地址时必须带 tcp:// 前缀，例如 tcp://81.70.63.53:1883
# broker 与本服务同机（含 Docker 发布端口）时用 tcp://127.0.0.1:1883：
# 走公网 IP 连自己会因 NAT 回流 / 容器 DNAT 规则不生效而连不上；
# 也不要写 localhost——部分机器 /etc/hosts 只把它解析到 ::1，会绕到 Docker 的 IPv6 转发上
MQTT_ENABLED=true
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=JavaService
# EMQX 开启认证后必填（后端原先不支持账号密码，现已支持）；留空为匿名连接
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=rtu/status
# 水情记录落库间隔（秒），默认 10 秒一条
MQTT_SAVE_INTERVAL_SECONDS=10

# 服务间消息总线（可选，默认值即建议值）
# 领取后的租约（秒）：超时没 ack 会被重投
# BUS_LEASE_SECONDS=120
# 最多领取次数，超过进死信
# BUS_MAX_ATTEMPTS=5
# 默认消息保留期（秒），7 天
# BUS_DEFAULT_TTL_SECONDS=604800
# 长轮询最多挂起（秒）
# BUS_MAX_WAIT_SECONDS=25

# JWT 签名密钥（至少 32 字节）。留空则每次启动生成随机密钥（重启后需重新登录）；
# 需要令牌跨重启有效时，请自行填入一个足够长的随机字符串
JWT_SECRET=
