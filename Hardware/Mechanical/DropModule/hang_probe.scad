// =============================================================================
// 悬挂方案 · 最小验证件（v5-probe）
//
// 目的：只验证一件事 —— 挂环套在横杆上，销子抽出后能否顺畅滑出杆端。
// 不需要舵机、不需要装整机。打印完插上就能试，5 分钟出结论。
//
// 三个小件
//   boom   横杆 Ø8 × 80，靠外端开竖直销孔
//   loop   挂环 内径 Ø22（环面垂直于杆轴）
//   pin    销子 Ø5（竖直插进销孔）
//
// 坐标（这一版修正了上一版的轴方向错误）
//   杆沿 **y** 轴：外端 y=0，内端 y=+BOOM_LEN
//   挂环套在杆上，被销子挡在 +y 一侧；销子抽出后向 -y 滑出、从 y=0 端掉下
//   销子沿 **z** 轴穿入销孔
//
// 上一版的两个错误（记录下来，避免重犯）
//   1. 杆用了 rotate([0,90,0])，把圆柱的 z 轴转到了 **x** 轴。
//      结果杆横在 x 方向，挂环/销子的相对位置全错。
//      要沿 y 轴，应该 rotate([-90,0,0])（+z -> +y）。
//   2. 外端加了「止挡凸缘」。这是自相矛盾的：挂环必须能从外端离开，
//      加了挡圈就永远出不去。已删除 —— 运输防滑靠销子本身，不需要挡圈。
//
// 为什么是这三个尺寸
//   杆 Ø8 / 环内径 Ø22  -> 单边间隙 7 mm，圆环能自由偏转不被卡
//   销 Ø5 / 孔 Ø5.6    -> 单边 0.3 mm，销子能自由落下不卡
//   倾斜 35° > 自锁角 19.3°（μ=0.35），余量 15.7°
//   即使摩擦翻倍到 μ=0.6（自锁角 31°）仍会滑出，只是慢一点
//
// 导出：pwsh -File build_probe.ps1
// =============================================================================

/* [选择导出] */
PART = "assembly";   // [assembly, boom, loop, pin]

/* [精度] */
$fn = 48;

// ---- 参数 ----
BOOM_D    = 8.0;     // 杆直径
BOOM_LEN  = 80.0;    // 杆总长
PIN_HOLE  = 5.6;     // 销孔直径
PIN_Y     = 15.0;    // 销孔距外端(y=0)的距离
EAR_D     = 4.0;     // 挂环截面直径
EAR_IN    = 22.0;    // 挂环内径
PIN_D     = 5.0;     // 销子直径
PIN_LEN   = 30.0;    // 销子长度
GRIP_LEN  = 10.0;    // 内端握柄（验证用，实装截掉）

EPS = 0.01;

// =============================================================================
// 1. 横杆：沿 y 轴，外端开放（挂环从这里掉出去）
// =============================================================================
module boom() {
    // 圆柱默认沿 +z，绕 x 轴转 -90° 后沿 +y
    rotate([-90, 0, 0])
        cylinder(d = BOOM_D, h = BOOM_LEN);

    // 内端握柄（验证时手持，实装时截掉或接铰链）
    translate([0, BOOM_LEN, 0])
        rotate([-90, 0, 0])
            cylinder(d = BOOM_D + 5.0, h = GRIP_LEN);

    // 竖直销孔：在 y=PIN_Y 处贯穿杆身
    translate([0, PIN_Y, 0])
        cylinder(d = PIN_HOLE, h = BOOM_D + 2, center = true);
}

// =============================================================================
// 2. 挂环：环面垂直于 y 轴（才能套在杆上）
//    rotate_extrude 绕 z 成环；绕 x 转 90° 后环轴变成 y
// =============================================================================
module loop() {
    rotate([90, 0, 0])
        rotate_extrude($fn = 64)
            translate([EAR_IN / 2 + EAR_D / 2, 0, 0])
                circle(d = EAR_D, $fn = 20);
}

// =============================================================================
// 3. 销子：沿 z 轴竖直插入
// =============================================================================
module pin() {
    cylinder(d = PIN_D, h = PIN_LEN);
    // 顶端捏头
    translate([0, 0, PIN_LEN])
        cylinder(d = PIN_D + 5.0, h = 3.0);
    // 底端倒角（便于插入）
    translate([0, 0, -EPS])
        cylinder(d1 = PIN_D - 1.6, d2 = PIN_D, h = 1.0);
}

// =============================================================================
// 装配示意：挂环在销子的 +y 侧（被挡住），销子竖直穿过杆
//   销子抽出后，挂环向 -y 滑出、从 y=0 端掉下
// =============================================================================
module assembly() {
    color("#98a0ab") boom();

    // 挂环：紧贴销子的内侧(+y)
    translate([0, PIN_Y + EAR_IN / 2 + EAR_D / 2 + 1.0, 0])
        color("#ef9d2e") loop();

    // 销子：竖直穿过销孔，长度中点在杆心
    translate([0, PIN_Y, -PIN_LEN / 2])
        color("#2f86e8") pin();
}

// include 本文件时不重复渲染（否则装配图里会出现两份杆）
RENDER_MAIN = is_undef(_HP_INCLUDED) ? 1 : 0;
if (RENDER_MAIN) {
    if (PART == "boom")      boom();
    else if (PART == "loop") loop();
    else if (PART == "pin")  pin();
    else                     assembly();
}
