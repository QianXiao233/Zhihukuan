# MQTT.js browser connection (EMQX-style WebSocket endpoint)
VITE_MQTT_BROKER_URL=wss://platform.zhka.qianxiao.xin/mqtt
# Optional when the broker enables authentication
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
VITE_MQTT_CLIENT_ID=
# Onboard camera Janus WebRTC endpoint and streaming plugin id
# /boat 页的驾驶台（/console/ 子应用）也用它：HTTPS 部署时必须换成 https/wss 反代地址，
# 否则浏览器会以混合内容拦掉船载视频。
VITE_JANUS_URL=http://192.168.2.14:8088/janus
VITE_JANUS_STREAM_ID=99
# 无人艇本地串口桥接服务（serial-service，默认 127.0.0.1:4174）
# 不填则驾驶台内默认连 http://127.0.0.1:4174；远程部署时改成可达的 http(s) 地址
VITE_BOAT_CONTROL_HTTP_URL=
# 监控中心视频网关（MediaMTX 默认 WebRTC/WHEP 端口 8889）
# RTSP 画面在这里转封装成 WebRTC；每路也可在「画面来源」里单独覆盖
VITE_VIDEO_GATEWAY_URL=http://127.0.0.1:8889
